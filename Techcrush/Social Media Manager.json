    {
      "parameters": {
        "jsCode": "const output = $json.output;\n\n// Parse the JSON string returned by the AI Agent\nconst data = JSON.parse(output);\n\n// Return each platform as a separate n8n item\nreturn [\n  {\n    json: {\n      platform: \"linkedin\",\n      topic: data.topic,\n      description: data.description,\n      content: data.linkedin.content,\n      tags: data.linkedin.tags\n    }\n  },\n  {\n    json: {\n      platform: \"twitter\",\n      topic: data.topic,\n      description: data.description,\n      content: data.twitter.content,\n      tags: data.twitter.tags\n    }\n  },\n  {\n    json: {\n      platform: \"telegram\",\n      topic: data.topic,\n      description: data.description,\n      content: data.telegram.content,\n      tags: data.telegram.tags\n    }\n  }\n];"
      },
